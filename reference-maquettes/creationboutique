<script>
        function nextStep(step) {
            // Hide all steps
            document.querySelectorAll('.step-transition').forEach(el => {
                el.classList.remove('active-step');
                el.classList.add('hidden-step');
            });
            // Show target step
            document.getElementById(`step-${step}`).classList.remove('hidden-step');
            document.getElementById(`step-${step}`).classList.add('active-step');

            // Update indicators
            updateIndicators(step);
        }

        function prevStep(step) {
             // Hide all steps
            document.querySelectorAll('.step-transition').forEach(el => {
                el.classList.remove('active-step');
                el.classList.add('hidden-step');
            });
            // Show target step
            document.getElementById(`step-${step}`).classList.remove('hidden-step');
            document.getElementById(`step-${step}`).classList.add('active-step');

            // Update indicators
            updateIndicators(step);
        }

        function updateIndicators(currentStep) {
            for (let i = 1; i <= 3; i++) {
                const ind = document.getElementById(`ind-${i}`);
                const line = document.getElementById(`line-${i}`); // line-3 doesn't exist, which is fine
                const text = document.getElementById(`ind-text-${i}`);
                
                if (i < currentStep) {
                    // Completed
                    ind.className = "relative flex h-8 w-8 items-center justify-center rounded-full bg-primary hover:bg-primary-container step-indicator transition-colors duration-300";
                    ind.innerHTML = `<span class="material-symbols-outlined text-on-primary text-[16px]" data-icon="check" style="font-variation-settings: 'FILL' 1;">check</span>`;
                    if (line) line.className = "h-0.5 w-full bg-primary transition-colors duration-300";
                } else if (i === currentStep) {
                    // Active
                    ind.className = "relative flex h-8 w-8 items-center justify-center rounded-full bg-primary hover:bg-primary-container step-indicator transition-colors duration-300";
                    ind.innerHTML = `<span class="font-label-md text-label-md text-on-primary">${i}</span>`;
                    if (line) line.className = "h-0.5 w-full bg-surface-variant transition-colors duration-300"; // Line after active is incomplete
                } else {
                    // Inactive
                    ind.className = "relative flex h-8 w-8 items-center justify-center rounded-full bg-surface-variant border-2 border-surface-variant hover:border-outline step-indicator transition-colors duration-300";
                    ind.innerHTML = `<span class="font-label-md text-label-md text-on-surface-variant">${i}</span>`;
                     if (line) line.className = "h-0.5 w-full bg-surface-variant transition-colors duration-300";
                }
            }
        }
    </script>
