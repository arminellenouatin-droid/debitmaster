<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>DebitManager Pro - Registration</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-tertiary-fixed": "#141d1b",
                    "on-secondary-fixed": "#271900",
                    "surface-container-high": "#e1e8fd",
                    "surface-container": "#e9edff",
                    "outline": "#707974",
                    "on-error-container": "#93000a",
                    "on-primary": "#ffffff",
                    "tertiary-container": "#3b4542",
                    "surface": "#f9f9ff",
                    "surface-bright": "#f9f9ff",
                    "surface-variant": "#dce2f7",
                    "primary-fixed-dim": "#99d3ba",
                    "on-tertiary-container": "#a7b2ae",
                    "on-surface-variant": "#404944",
                    "on-primary-fixed-variant": "#15503e",
                    "outline-variant": "#bfc9c3",
                    "secondary-fixed": "#ffdeaa",
                    "inverse-on-surface": "#edf0ff",
                    "on-tertiary-fixed-variant": "#3f4946",
                    "on-background": "#141b2b",
                    "primary-container": "#0f4c3a",
                    "on-secondary": "#ffffff",
                    "inverse-surface": "#293040",
                    "inverse-primary": "#99d3ba",
                    "tertiary": "#252f2c",
                    "secondary-container": "#ffc55f",
                    "on-error": "#ffffff",
                    "on-secondary-container": "#755100",
                    "background": "#f9f9ff",
                    "on-secondary-fixed-variant": "#5f4100",
                    "secondary-fixed-dim": "#f5bd58",
                    "on-primary-container": "#82bba4",
                    "secondary": "#7d5700",
                    "surface-container-low": "#f1f3ff",
                    "surface-dim": "#d3daef",
                    "on-surface": "#141b2b",
                    "primary": "#003426",
                    "on-primary-fixed": "#002117",
                    "surface-container-highest": "#dce2f7",
                    "tertiary-fixed": "#dae5e0",
                    "tertiary-fixed-dim": "#bec9c4",
                    "primary-fixed": "#b4efd6",
                    "error-container": "#ffdad6",
                    "surface-container-lowest": "#ffffff",
                    "surface-tint": "#306855",
                    "error": "#ba1a1a",
                    "on-tertiary": "#ffffff"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "base": "4px",
                    "xs": "8px",
                    "max-content-width": "1440px",
                    "md": "24px",
                    "sm": "16px",
                    "lg": "32px",
                    "xl": "48px",
                    "sidebar-width": "260px"
            },
            "fontFamily": {
                    "body-lg": ["Inter"],
                    "body-md": ["Inter"],
                    "headline-lg-mobile": ["Inter"],
                    "display": ["Inter"],
                    "headline-md": ["Inter"],
                    "label-md": ["Inter"],
                    "amount-md": ["Inter"],
                    "headline-lg": ["Inter"]
            },
            "fontSize": {
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                    "display": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                    "amount-md": ["18px", {"lineHeight": "24px", "fontWeight": "600"}],
                    "headline-lg": ["28px", {"lineHeight": "36px", "fontWeight": "700"}]
            }
          }
        }
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .material-symbols-outlined[data-weight="fill"] {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex items-center justify-center p-md">
<!-- Main Container -->
<main class="w-full max-w-[480px] bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant overflow-hidden flex flex-col relative min-h-[600px]">
<!-- Header -->
<header class="p-lg pb-sm text-center flex flex-col items-center">
<div class="w-16 h-16 bg-primary-container rounded-full flex items-center justify-center mb-4 text-on-primary-container">
<span class="material-symbols-outlined text-4xl" data-icon="storefront">storefront</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-primary mb-2">Create Account</h1>
<p class="font-body-md text-body-md text-on-surface-variant">Join Maquis Master to manage your business efficiently.</p>
</header>
<!-- Form Section (Step 1) -->
<section class="flex-1 p-lg pt-0 flex flex-col gap-md transition-opacity duration-300" id="step-1-form">
<div class="space-y-4">
<!-- Name -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-xs" for="fullName">Full Name</label>
<div class="relative">
<span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
<span class="material-symbols-outlined" data-icon="person">person</span>
</span>
<input class="block w-full pl-10 pr-3 py-3 border border-outline rounded-lg bg-surface focus:ring-2 focus:ring-primary focus:border-primary transition-colors text-on-surface placeholder-on-surface-variant/50 outline-none" id="fullName" placeholder="e.g. Koffi Kouakou" type="text"/>
</div>
</div>
<!-- Phone -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-xs" for="phone">Phone Number</label>
<div class="flex">
<span class="inline-flex items-center px-3 border border-r-0 border-outline rounded-l-lg bg-surface-variant text-on-surface-variant text-sm font-medium">
                            🇨🇮 +225
                        </span>
<input class="block w-full px-3 py-3 border border-outline rounded-r-lg bg-surface focus:ring-2 focus:ring-primary focus:border-primary transition-colors text-on-surface placeholder-on-surface-variant/50 outline-none" id="phone" placeholder="01 23 45 67 89" type="tel"/>
</div>
</div>
<!-- Email -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-xs" for="email">Email Address (Optional)</label>
<div class="relative">
<span class="absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
<span class="material-symbols-outlined" data-icon="mail">mail</span>
</span>
<input class="block w-full pl-10 pr-3 py-3 border border-outline rounded-lg bg-surface focus:ring-2 focus:ring-primary focus:border-primary transition-colors text-on-surface placeholder-on-surface-variant/50 outline-none" id="email" placeholder="koffi@example.com" type="email"/>
</div>
</div>
</div>
<div class="mt-auto pt-lg">
<button class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-4 rounded-lg font-headline-md text-headline-md hover:bg-primary/90 active:scale-[0.98] transition-all" id="continue-btn">
                    Continue
                    <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
</button>
</div>
<!-- Social Logins -->
<div class="mt-sm pt-sm border-t border-outline-variant">
<p class="text-center font-label-md text-label-md text-on-surface-variant mb-4">Or sign up with</p>
<div class="flex gap-4 justify-center">
<button class="flex-1 flex items-center justify-center py-3 border border-outline rounded-lg hover:bg-surface-variant transition-colors text-on-surface font-label-md">
                        Google
                    </button>
<button class="flex-1 flex items-center justify-center py-3 border border-outline rounded-lg hover:bg-surface-variant transition-colors text-on-surface font-label-md">
                        Facebook
                    </button>
</div>
</div>
</section>
<!-- OTP Section (Step 2 - Initially Hidden) -->
<section class="hidden flex-1 p-lg flex flex-col items-center gap-lg transition-opacity duration-300" id="step-2-otp">
<div class="text-center mb-4">
<p class="font-body-md text-body-md text-on-surface-variant mb-2">We sent a 4-digit code to</p>
<p class="font-headline-md text-headline-md text-on-surface">+225 01 23 45 67 89</p>
<button class="text-primary font-label-md text-label-md mt-2 flex items-center justify-center gap-1 mx-auto hover:underline" id="edit-phone-btn">
<span class="material-symbols-outlined text-[16px]" data-icon="edit">edit</span> Edit number
                </button>
</div>
<div class="flex gap-4 justify-center w-full max-w-[300px]">
<input autofocus="" class="w-14 h-16 text-center font-display text-display border-2 border-outline rounded-lg bg-surface focus:border-primary focus:ring-0 outline-none transition-colors" maxlength="1" type="text"/>
<input class="w-14 h-16 text-center font-display text-display border-2 border-outline rounded-lg bg-surface focus:border-primary focus:ring-0 outline-none transition-colors" maxlength="1" type="text"/>
<input class="w-14 h-16 text-center font-display text-display border-2 border-outline rounded-lg bg-surface focus:border-primary focus:ring-0 outline-none transition-colors" maxlength="1" type="text"/>
<input class="w-14 h-16 text-center font-display text-display border-2 border-outline rounded-lg bg-surface focus:border-primary focus:ring-0 outline-none transition-colors" maxlength="1" type="text"/>
</div>
<div class="text-center mt-4 w-full">
<p class="font-body-md text-body-md text-on-surface-variant mb-4">Didn't receive the code?</p>
<button class="text-primary font-label-md text-label-md font-bold hover:underline">Resend Code (00:59)</button>
</div>
<div class="mt-auto pt-lg w-full">
<button class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-4 rounded-lg font-headline-md text-headline-md hover:bg-primary/90 active:scale-[0.98] transition-all">
                    Verify &amp; Create Account
                    <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
</button>
</div>
</section>
</main>
<script>
        document.addEventListener('DOMContentLoaded', () => {
            const step1 = document.getElementById('step-1-form');
            const step2 = document.getElementById('step-2-otp');
            const continueBtn = document.getElementById('continue-btn');
            const editPhoneBtn = document.getElementById('edit-phone-btn');
            const otpInputs = step2.querySelectorAll('input[type="text"]');

            // Switch to OTP view
            continueBtn.addEventListener('click', (e) => {
                e.preventDefault();
                step1.classList.add('hidden');
                step2.classList.remove('hidden');
                otpInputs[0].focus();
            });

            // Go back to Form view
            editPhoneBtn.addEventListener('click', () => {
                step2.classList.add('hidden');
                step1.classList.remove('hidden');
            });

            // Auto-advance OTP inputs
            otpInputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    if (e.target.value.length === 1 && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }
                });
                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && e.target.value.length === 0 && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });
        });
    </script>
</body></html>