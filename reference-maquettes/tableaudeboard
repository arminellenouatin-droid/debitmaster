<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Dashboard - Maquis Master</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed": "#141d1b",
                        "on-secondary-fixed": "#271900",
                        "surface-container-high": "#e1e8fd",
                        "surface-container": "#e9edff",
                        "outline": "#707974",
                        "on-error-container": "#93000a",
                        "on-primary": "#ffffff",
                        "tertiary-container": "#3b4542",
                        "surface": "#f9f9ff",
                        "surface-bright": "#f9f9ff",
                        "surface-variant": "#dce2f7",
                        "primary-fixed-dim": "#99d3ba",
                        "on-tertiary-container": "#a7b2ae",
                        "on-surface-variant": "#404944",
                        "on-primary-fixed-variant": "#15503e",
                        "outline-variant": "#bfc9c3",
                        "secondary-fixed": "#ffdeaa",
                        "inverse-on-surface": "#edf0ff",
                        "on-tertiary-fixed-variant": "#3f4946",
                        "on-background": "#141b2b",
                        "primary-container": "#0f4c3a",
                        "on-secondary": "#ffffff",
                        "inverse-surface": "#293040",
                        "inverse-primary": "#99d3ba",
                        "tertiary": "#252f2c",
                        "secondary-container": "#ffc55f",
                        "on-error": "#ffffff",
                        "on-secondary-container": "#755100",
                        "background": "#f9f9ff",
                        "on-secondary-fixed-variant": "#5f4100",
                        "secondary-fixed-dim": "#f5bd58",
                        "on-primary-container": "#82bba4",
                        "secondary": "#7d5700",
                        "surface-container-low": "#f1f3ff",
                        "surface-dim": "#d3daef",
                        "on-surface": "#141b2b",
                        "primary": "#003426",
                        "on-primary-fixed": "#002117",
                        "surface-container-highest": "#dce2f7",
                        "tertiary-fixed": "#dae5e0",
                        "tertiary-fixed-dim": "#bec9c4",
                        "primary-fixed": "#b4efd6",
                        "error-container": "#ffdad6",
                        "surface-container-lowest": "#ffffff",
                        "surface-tint": "#306855",
                        "error": "#ba1a1a",
                        "on-tertiary": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "4px",
                        "xs": "8px",
                        "max-content-width": "1440px",
                        "md": "24px",
                        "sm": "16px",
                        "lg": "32px",
                        "xl": "48px",
                        "sidebar-width": "260px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "display": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-md": ["Inter"],
                        "amount-md": ["Inter"],
                        "headline-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "amount-md": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "headline-lg": ["28px", { "lineHeight": "36px", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-[#F7F8F7] text-on-surface font-body-md min-h-screen">
<!-- TopNavBar -->
<header class="fixed top-0 right-0 h-[72px] left-[260px] bg-surface-container-lowest border-b border-outline-variant shadow-sm z-50 flex justify-between items-center px-lg w-[calc(100%-260px)] hidden md:flex">
<div class="flex items-center gap-sm">
<h1 class="font-headline-md text-headline-md font-bold text-primary">DebitManager</h1>
<div class="w-3 h-3 rounded-full bg-primary" title="Online"></div>
</div>
<div class="flex items-center gap-md">
<button class="text-on-surface-variant hover:bg-surface-container-high transition-colors p-2 rounded-full cursor-pointer active:opacity-80">
<span class="material-symbols-outlined">notifications</span>
</button>
<button class="text-on-surface-variant hover:bg-surface-container-high transition-colors p-2 rounded-full cursor-pointer active:opacity-80 flex items-center gap-2">
<span class="material-symbols-outlined">account_circle</span>
</button>
</div>
</header>
<!-- SideNavBar -->
<nav class="fixed left-0 top-0 h-full w-[260px] bg-primary border-r border-outline-variant shadow-sm z-50 hidden md:flex flex-col">
<div class="flex flex-col h-full p-md w-full">
<div class="mb-xl px-4">
<h2 class="font-headline-md text-headline-md font-bold text-on-primary">Maquis Master</h2>
<p class="font-label-md text-label-md text-on-primary/70">DebitManager Pro</p>
</div>
<div class="flex flex-col gap-xs flex-1">
<a class="flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-lg font-bold transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">dashboard</span>
<span>Dashboard</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">table_restaurant</span>
<span>Tables</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">receipt_long</span>
<span>Orders</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">inventory_2</span>
<span>Stock</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">group</span>
<span>Personnel</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">payments</span>
<span>Finance</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">chat</span>
<span>Messages</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">settings</span>
<span>Settings</span>
</a>
</div>
<div class="mt-auto flex flex-col gap-xs pt-md border-t border-on-primary/20">
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">help</span>
<span>Support</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-primary/70 hover:text-on-primary hover:bg-primary-fixed-dim/20 transition-colors rounded-lg transition-all duration-200 active:scale-95" href="#">
<span class="material-symbols-outlined">logout</span>
<span>Logout</span>
</a>
</div>
</div>
</nav>
<!-- Main Content Area -->
<main class="md:ml-[260px] pt-[72px] min-h-screen p-md lg:p-lg">
<div class="max-w-max-content-width mx-auto space-y-md">
<!-- Hero Metric -->
<div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-outline/20">
<h3 class="font-body-lg text-body-lg text-on-surface-variant mb-xs">Chiffre d'Affaires du Jour</h3>
<div class="flex items-baseline gap-sm">
<span class="font-display text-display text-primary">1,245,500</span>
<span class="font-amount-md text-amount-md text-primary/70">FCFA</span>
</div>
<div class="flex items-center gap-2 mt-sm text-primary">
<span class="material-symbols-outlined text-sm">trending_up</span>
<span class="font-label-md text-label-md">+15% vs hier</span>
</div>
</div>
<!-- KPI Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
<!-- Orders -->
<div class="bg-surface-container-lowest rounded-xl p-md shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-outline/20 flex flex-col justify-between h-[140px]">
<div class="flex justify-between items-start">
<span class="material-symbols-outlined text-secondary">receipt_long</span>
<span class="font-label-md text-label-md bg-secondary-container/20 text-on-secondary-container px-2 py-1 rounded-full">+45</span>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant">Orders</p>
<p class="font-headline-md text-headline-md text-on-surface">142</p>
</div>
</div>
<!-- Personnel -->
<div class="bg-surface-container-lowest rounded-xl p-md shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-outline/20 flex flex-col justify-between h-[140px]">
<div class="flex justify-between items-start">
<span class="material-symbols-outlined text-primary">group</span>
<div class="w-2 h-2 rounded-full bg-primary mt-2"></div>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant">Personnel</p>
<p class="font-headline-md text-headline-md text-on-surface">12 / 15</p>
</div>
</div>
<!-- Stock Alerts -->
<div class="bg-surface-container-lowest rounded-xl p-md shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-error/50 flex flex-col justify-between h-[140px]">
<div class="flex justify-between items-start">
<span class="material-symbols-outlined text-error">warning</span>
<span class="font-label-md text-label-md bg-error-container text-on-error-container px-2 py-1 rounded-full uppercase">Alert</span>
</div>
<div>
<p class="font-label-md text-label-md text-error">Stock Alerts</p>
<p class="font-headline-md text-headline-md text-on-surface">3 Items</p>
</div>
</div>
<!-- Cash Status -->
<div class="bg-surface-container-lowest rounded-xl p-md shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-outline/20 flex flex-col justify-between h-[140px]">
<div class="flex justify-between items-start">
<span class="material-symbols-outlined text-primary-container">payments</span>
<span class="material-symbols-outlined text-primary-container text-sm">check_circle</span>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface-variant">Cash Status</p>
<p class="font-headline-md text-headline-md text-on-surface">Balanced</p>
</div>
</div>
</div>
<!-- Sales Graph Area (Placeholder for actual chart) -->
<div class="bg-surface-container-lowest rounded-xl p-lg shadow-[0px_2px_4px_rgba(0,0,0,0.05)] border border-outline/20">
<h3 class="font-headline-md text-headline-md text-on-surface mb-md">Weekly Sales Trend</h3>
<div class="w-full h-64 bg-surface-variant/30 rounded-lg flex items-center justify-center border border-outline-variant border-dashed">
<div class="text-center">
<span class="material-symbols-outlined text-on-surface-variant/50 text-4xl mb-2">bar_chart</span>
<p class="font-body-md text-body-md text-on-surface-variant/70">Sales visualization chart goes here</p>
</div>
</div>
</div>
</div>
</main>
</body></html>