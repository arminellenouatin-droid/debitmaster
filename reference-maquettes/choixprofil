<!DOCTYPE html>

<html class="light" lang="fr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>DebitManager Pro - Choix de profil</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed": "#141d1b",
                        "on-secondary-fixed": "#271900",
                        "surface-container-high": "#e1e8fd",
                        "surface-container": "#e9edff",
                        "outline": "#707974",
                        "on-error-container": "#93000a",
                        "on-primary": "#ffffff",
                        "tertiary-container": "#3b4542",
                        "surface": "#f9f9ff",
                        "surface-bright": "#f9f9ff",
                        "surface-variant": "#dce2f7",
                        "primary-fixed-dim": "#99d3ba",
                        "on-tertiary-container": "#a7b2ae",
                        "on-surface-variant": "#404944",
                        "on-primary-fixed-variant": "#15503e",
                        "outline-variant": "#bfc9c3",
                        "secondary-fixed": "#ffdeaa",
                        "inverse-on-surface": "#edf0ff",
                        "on-tertiary-fixed-variant": "#3f4946",
                        "on-background": "#141b2b",
                        "primary-container": "#0f4c3a",
                        "on-secondary": "#ffffff",
                        "inverse-surface": "#293040",
                        "inverse-primary": "#99d3ba",
                        "tertiary": "#252f2c",
                        "secondary-container": "#ffc55f",
                        "on-error": "#ffffff",
                        "on-secondary-container": "#755100",
                        "background": "#f9f9ff",
                        "on-secondary-fixed-variant": "#5f4100",
                        "secondary-fixed-dim": "#f5bd58",
                        "on-primary-container": "#82bba4",
                        "secondary": "#7d5700",
                        "surface-container-low": "#f1f3ff",
                        "surface-dim": "#d3daef",
                        "on-surface": "#141b2b",
                        "primary": "#003426",
                        "on-primary-fixed": "#002117",
                        "surface-container-highest": "#dce2f7",
                        "tertiary-fixed": "#dae5e0",
                        "tertiary-fixed-dim": "#bec9c4",
                        "primary-fixed": "#b4efd6",
                        "error-container": "#ffdad6",
                        "surface-container-lowest": "#ffffff",
                        "surface-tint": "#306855",
                        "error": "#ba1a1a",
                        "on-tertiary": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "4px",
                        "xs": "8px",
                        "max-content-width": "1440px",
                        "md": "24px",
                        "sm": "16px",
                        "lg": "32px",
                        "xl": "48px",
                        "sidebar-width": "260px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "display": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-md": ["Inter"],
                        "amount-md": ["Inter"],
                        "headline-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "amount-md": ["18px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "headline-lg": ["28px", { "lineHeight": "36px", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
<style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center p-md md:p-lg">
<main class="w-full max-w-4xl mx-auto flex flex-col gap-lg">
<!-- Header Section -->
<header class="text-center mb-xl">
<h1 class="font-display text-display text-primary mb-sm">Bienvenue sur DebitManager Pro</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Veuillez choisir comment vous souhaitez configurer votre environnement de travail aujourd'hui.</p>
</header>
<!-- Bento Grid for Choices -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-lg relative">
<!-- Choice 1: Create Shop -->
<button class="group relative flex flex-col items-center justify-center p-xl bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden min-h-[320px] text-left w-full focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
<div class="absolute inset-0 bg-gradient-to-br from-primary-fixed/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
<div class="z-10 flex flex-col items-center text-center">
<div class="w-20 h-20 rounded-full bg-primary-container flex items-center justify-center mb-md group-hover:scale-110 transition-transform duration-300">
<span class="material-symbols-outlined text-4xl text-on-primary-container" style="font-variation-settings: 'FILL' 1;">storefront</span>
</div>
<h2 class="font-headline-md text-headline-md text-on-surface mb-xs">Créer ma boutique</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Configurez un nouvel établissement, gérez votre inventaire et votre personnel dès maintenant.</p>
</div>
<!-- Decorative element -->
<div class="absolute -bottom-10 -right-10 w-32 h-32 bg-primary-fixed/30 rounded-full blur-2xl group-hover:bg-primary-fixed/50 transition-colors duration-300"></div>
</button>
<!-- Choice 2: Join Shop -->
<div class="relative flex flex-col p-xl bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm hover:shadow-lg transition-all duration-300 min-h-[320px] group focus-within:ring-2 focus-within:ring-primary focus-within:border-transparent">
<div class="absolute inset-0 bg-gradient-to-bl from-secondary-fixed/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl pointer-events-none"></div>
<div class="z-10 flex flex-col h-full">
<div class="flex flex-col items-center text-center mb-lg flex-grow">
<div class="w-20 h-20 rounded-full bg-secondary-container flex items-center justify-center mb-md group-hover:scale-110 transition-transform duration-300">
<span class="material-symbols-outlined text-4xl text-on-secondary-container" style="font-variation-settings: 'FILL' 1;">group_add</span>
</div>
<h2 class="font-headline-md text-headline-md text-on-surface mb-xs">Rejoindre une boutique</h2>
<p class="font-body-md text-body-md text-on-surface-variant">Intégrez une équipe existante en utilisant votre code société unique fourni par votre manager.</p>
</div>
<!-- Input Form -->
<form class="w-full mt-auto" onsubmit="event.preventDefault(); alert('Rejoindre avec le code...');">
<label class="block font-label-md text-label-md text-on-surface mb-xs sr-only" for="company-code">Code Société</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-sm text-on-surface-variant">vpn_key</span>
<input class="w-full pl-xl pr-sm py-3 bg-surface border border-outline rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-shadow placeholder:text-on-surface-variant/50 uppercase" id="company-code" name="company-code" placeholder="Entrez le Code Société" required="" type="text"/>
<button aria-label="Valider" class="absolute right-sm p-xs bg-primary text-on-primary rounded-md hover:bg-primary/90 transition-colors flex items-center justify-center h-[36px] w-[36px]" type="submit">
<span class="material-symbols-outlined text-sm">arrow_forward</span>
</button>
</div>
</form>
</div>
</div>
</div>
</main>
</body></html>